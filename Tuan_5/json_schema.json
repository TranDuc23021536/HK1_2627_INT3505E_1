{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/library.json",
  "title": "Library API - JSON Schema cho 3 resource chinh: Book, Member, Loan",
  "$defs": {
    "CategoryRef": {
      "type": "object",
      "required": ["id", "slug"],
      "properties": {
        "id": { "type": "integer" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    },
    "AuthorRef": {
      "type": "object",
      "required": ["id", "name", "role"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["lead", "co", "ed"] }
      }
    },
    "Book": {
      "type": "object",
      "required": ["id", "title", "isbn", "category", "authors", "totalCopies", "availableCopies"],
      "properties": {
        "id": { "type": "string", "pattern": "^book_[0-9]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "isbn": { "type": "string", "pattern": "^[0-9]{13}$" },
        "category": { "$ref": "#/$defs/CategoryRef" },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/AuthorRef" }
        },
        "publishedYear": { "type": "integer", "minimum": 1000, "maximum": 2100 },
        "totalCopies": { "type": "integer", "minimum": 0 },
        "availableCopies": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "Member": {
      "type": "object",
      "required": ["id", "fullName", "email", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^member_[0-9]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string", "pattern": "^[0-9+ -]{8,15}$" },
        "status": { "enum": ["active", "suspended"] },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "Loan": {
      "type": "object",
      "required": ["id", "memberId", "bookId", "borrowedAt", "dueAt", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^loan_[0-9]+$" },
        "memberId": { "type": "string", "pattern": "^member_[0-9]+$" },
        "bookId": { "type": "string", "pattern": "^book_[0-9]+$" },
        "borrowedAt": { "type": "string", "format": "date-time" },
        "dueAt": { "type": "string", "format": "date-time" },
        "returnedAt": { "type": ["string", "null"], "format": "date-time" },
        "status": { "enum": ["borrowed", "returned", "overdue"] }
      },
      "additionalProperties": false
    }
  }
}
